module
public import Mathlib

/-!
# The none-one-tons semiring `{0, 1, ω}` (Section 4.1)

Granule represents linear logic's `!` as the graded modality `□_ω` over the pre-ordered
semiring `{0, 1, ω}`, where
* `r + s = r` if `s = 0`, `r + s = s` if `r = 0`, and `ω` otherwise;
* `r * 0 = 0 * r = 0`, `r * ω = ω * r = ω` (for `r ≠ 0`), `r * 1 = 1 * r = r`;
* the order is the reflexive relation generated by `0 ⊑ ω` and `1 ⊑ ω`.

We define this structure, show that it is a commutative semiring, and that the order is
a partial order with respect to which addition and multiplication are monotone.
-/

@[expose] public section

namespace LCU

/-- The grades `{0, 1, ω}`. -/
inductive NOT where
  | zero
  | one
  | many
  deriving DecidableEq, Fintype, Repr

namespace NOT

/-- Addition: `r + 0 = r`, `0 + s = s`, otherwise `ω`. -/
def add : NOT → NOT → NOT
  | r, zero => r
  | zero, s => s
  | _, _ => many

/-- Multiplication: `0` is absorbing, then `ω` is absorbing, and `1` is the unit. -/
def mul : NOT → NOT → NOT
  | zero, _ => zero
  | _, zero => zero
  | many, _ => many
  | _, many => many
  | one, one => one

/-- The pre-order: reflexivity together with `0 ⊑ ω` and `1 ⊑ ω`. -/
def le (r s : NOT) : Prop := r = s ∨ s = many

instance : DecidableRel le := fun r s => inferInstanceAs (Decidable (r = s ∨ s = many))

instance : Zero NOT := ⟨zero⟩
instance : One NOT := ⟨one⟩
instance : Add NOT := ⟨add⟩
instance : Mul NOT := ⟨mul⟩

theorem add_def (r s : NOT) : r + s = add r s := rfl
theorem mul_def (r s : NOT) : r * s = mul r s := rfl

/-- `{0, 1, ω}` is a commutative semiring. -/
instance : CommSemiring NOT where
  add_assoc := by decide
  zero_add := by decide
  add_zero := by decide
  add_comm := by decide
  mul_assoc := by decide
  one_mul := by decide
  mul_one := by decide
  zero_mul := by decide
  mul_zero := by decide
  left_distrib := by decide
  right_distrib := by decide
  mul_comm := by decide
  nsmul := nsmulRec

/-- The order is a partial order. -/
instance : PartialOrder NOT where
  le := le
  le_refl := by decide
  le_trans := by decide
  le_antisymm := by decide

theorem le_iff (r s : NOT) : r ≤ s ↔ r = s ∨ s = many := Iff.rfl

instance decLe : DecidableRel (α := NOT) (· ≤ ·) :=
  fun r s => decidable_of_iff _ (le_iff r s).symm

/-- Addition is monotone. -/
theorem add_le_add' {r r' s s' : NOT} (h₁ : r ≤ r') (h₂ : s ≤ s') : r + s ≤ r' + s' := by
  revert r r' s s'; decide

/-- Multiplication is monotone. -/
theorem mul_le_mul' {r r' s s' : NOT} (h₁ : r ≤ r') (h₂ : s ≤ s') : r * s ≤ r' * s' := by
  revert r r' s s'; decide

/-- `ω` is the top element. -/
theorem le_many (r : NOT) : r ≤ many := Or.inr rfl

/-- `ω` is idempotent for addition and multiplication. -/
theorem many_add_many : many + many = many := rfl
theorem many_mul_many : many * many = many := rfl

/-- `0` and `1` are incomparable: discarding and linear use are distinct. -/
theorem zero_one_incomparable : ¬ (0 : NOT) ≤ 1 ∧ ¬ (1 : NOT) ≤ 0 := by decide

end NOT

end LCU
